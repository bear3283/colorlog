        },
        "ko" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, 고친 색" : {
      "comment" : "VoiceOver. 색을 고친 기본 팔레트",
      "localizations" : {
